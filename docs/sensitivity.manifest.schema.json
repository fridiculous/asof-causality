{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fridiculous/asof-causality/docs/sensitivity.manifest.schema.json",
  "title": "asof-causality sensitivity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "hash_algorithm",
    "run_started_utc",
    "invocation",
    "invocation_args",
    "source_commit",
    "workspace_dirty",
    "rust_toolchain",
    "timestamp_shift_time_axis",
    "timestamp_shift_semantics",
    "fixture_path",
    "fixture_hash",
    "signal",
    "signal_config_descriptor",
    "baseline_policy",
    "baseline_transcript_hash",
    "policies",
    "summary_path",
    "summary_hash",
    "sensitivity_curve_svg_path",
    "sensitivity_curve_svg_hash",
    "flip_rate_svg_path",
    "flip_rate_svg_hash",
    "input_change_svg_path",
    "input_change_svg_hash",
    "details_path",
    "details_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "sensitivity-v1"
    },
    "tool": {
      "const": "asof-causality"
    },
    "hash_algorithm": {
      "const": "blake3"
    },
    "run_started_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "invocation": {
      "type": "string",
      "minLength": 1
    },
    "invocation_args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "source_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "workspace_dirty": {
      "type": ["boolean", "null"]
    },
    "rust_toolchain": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "timestamp_shift_time_axis": {
      "const": "fixture_native_integer"
    },
    "timestamp_shift_semantics": {
      "const": "raw signed integer arithmetic on received_time; no calendar validation"
    },
    "fixture_path": {
      "type": "string",
      "minLength": 1
    },
    "fixture_hash": {
      "$ref": "#/$defs/blake3"
    },
    "signal": {
      "$ref": "#/$defs/signal"
    },
    "signal_config_descriptor": {
      "type": "string"
    },
    "baseline_policy": {
      "const": "strict_received_time"
    },
    "baseline_transcript_hash": {
      "$ref": "#/$defs/blake3"
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy_run"
      },
      "minItems": 1
    },
    "summary_path": {
      "type": "string",
      "minLength": 1
    },
    "summary_hash": {
      "$ref": "#/$defs/blake3"
    },
    "sensitivity_curve_svg_path": {
      "type": "string",
      "minLength": 1
    },
    "sensitivity_curve_svg_hash": {
      "$ref": "#/$defs/blake3"
    },
    "flip_rate_svg_path": {
      "type": "string",
      "minLength": 1
    },
    "flip_rate_svg_hash": {
      "$ref": "#/$defs/blake3"
    },
    "input_change_svg_path": {
      "type": "string",
      "minLength": 1
    },
    "input_change_svg_hash": {
      "$ref": "#/$defs/blake3"
    },
    "details_path": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "details_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/blake3"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "blake3": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "category": {
      "enum": ["baseline", "synthetic_stress", "realistic_failure"]
    },
    "signal": {
      "enum": [
        "last-feature-sentiment",
        "windowed-feature-sentiment",
        "windowed-zscore"
      ]
    },
    "policy_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "descriptor",
        "events_transformed",
        "transformed_fixture_hash",
        "transcript_hash"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "descriptor": {
          "$ref": "#/$defs/policy_descriptor"
        },
        "events_transformed": {
          "type": "integer",
          "minimum": 0
        },
        "transformed_fixture_hash": {
          "$ref": "#/$defs/blake3"
        },
        "transcript_hash": {
          "$ref": "#/$defs/blake3"
        }
      }
    },
    "policy_descriptor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "category", "kind"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "const": "baseline"
            },
            "kind": {
              "const": "identity"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "category",
            "kind",
            "time_axis",
            "shift_units",
            "calendar_aware",
            "roles_affected",
            "shift",
            "preserve"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "const": "synthetic_stress"
            },
            "kind": {
              "const": "received_time_shift"
            },
            "time_axis": {
              "const": "fixture_native_integer"
            },
            "shift_units": {
              "const": "fixture_native_integer"
            },
            "calendar_aware": {
              "const": false
            },
            "roles_affected": {
              "type": "array",
              "items": {
                "enum": ["feature", "feature_correction", "prediction", "outcome"]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "shift": {
              "type": "integer"
            },
            "preserve": {
              "const": ["event_id", "observed_time", "sequence", "symbol", "payload"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "category", "kind", "order"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "const": "realistic_failure"
            },
            "kind": {
              "const": "replay_order_override"
            },
            "order": {
              "enum": ["received_time", "observed_time"]
            }
          }
        }
      ]
    }
  }
}
